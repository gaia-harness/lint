{
  "name": "@gaia-react/lint",
  "version": "3.0.0-rc.6",
  "description": "GAIA's opinionated lint configuration.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./prettier": {
      "import": "./dist/prettier.js",
      "types": "./dist/prettier.d.ts"
    },
    "./stylelint": {
      "import": "./dist/stylelint.js",
      "types": "./dist/stylelint.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 src",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.9.0",
  "peerDependencies": {
    "eslint": "^9.30.0",
    "prettier": "^3.0.0",
    "stylelint": "^17.0.0",
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.26.0",
    "@eslint/config-helpers": "0.7.0",
    "@eslint/js": "9.39.4",
    "@shadcn/lint": "0.2.1",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint-config-airbnb-extended": "3.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-better-tailwindcss": "4.9.0",
    "eslint-plugin-canonical": "5.1.3",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-prefer-arrow-functions": "3.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-storybook": "10.6.1",
    "eslint-plugin-unicorn": "65.0.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-you-dont-need-lodash-underscore": "6.14.0",
    "eslint-plugin-zod": "5.0.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "stylelint-config-clean-order": "10.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "stylelint-order": "8.1.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "stylelint": "^17.16.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "author": "Steven Sacks <stevensacks@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaia-react/lint.git"
  },
  "homepage": "https://github.com/gaia-react/lint#readme",
  "bugs": {
    "url": "https://github.com/gaia-react/lint/issues"
  },
  "keywords": [
    "gaia",
    "gaia-react",
    "eslint",
    "eslint-config",
    "flat-config",
    "react",
    "typescript",
    "lint"
  ]
}
